# Common
KOV_CONFIG_PATH=configs/dev.yaml

# Postgres
POSTGRES_DB=kov
POSTGRES_USER=kov
POSTGRES_PASSWORD=kov
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Qdrant
QDRANT_URL=http://qdrant:6333
QDRANT_TIMEOUT_SECONDS=120
QDRANT_UPSERT_BATCH_SIZE=64

# S3 (MinIO / rustfs compatible)
S3_ENDPOINT_URL=http://minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=kov-artifacts
S3_REGION=us-east-1

# Telegram
TELEGRAM_BOT_TOKEN=replace_me

# Admin (nginx basic-auth in prod)
ADMIN_USER=admin
ADMIN_PASSWORD=replace_me_strong_password

# CORS (comma-separated, optional)
# Example: CORS_ALLOWED_ORIGINS=https://admin.example.com,https://app.example.com
CORS_ALLOWED_ORIGINS=

# Backups (every 2 hours, keep 36h by default)
BACKUP_INTERVAL_MINUTES=120
BACKUP_KEEP_HOURS=36
# Include app S3 bucket data inside backup archive (can be heavy)
BACKUP_INCLUDE_S3_DATA=1

# Optional: upload backups to separate S3 storage
BACKUP_S3_ENDPOINT_URL=
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=
BACKUP_S3_BUCKET=
BACKUP_S3_REGION=
BACKUP_S3_PREFIX=backups

# RAG scan chunking
# semantic is recommended; simple is the legacy char-based chunker
RAG_SCAN_CHUNKING_MODE=semantic
RAG_SCAN_STRIP_HEADERS_FOOTERS=true
RAG_SCAN_DROP_LOW_SIGNAL=true
RAG_SCAN_MIN_ALPHA_CHARS=20

# RAG search reranker (LLM-based; skipped if LLM not configured)
RAG_SEARCH_RERANKER_ENABLED=true
RAG_SEARCH_RERANKER_MODE=list
RAG_SEARCH_RERANKER_TOP_N=100
RAG_SEARCH_RERANKER_FINAL_K=100
RAG_SEARCH_RERANKER_PASSAGE_MAX_CHARS=800
RAG_SEARCH_RERANKER_CONCURRENCY=8
RAG_SEARCH_RERANKER_MODEL=

# RAG search planner (LLM-based query generation)
RAG_SEARCH_PLANNER_USE_LLM=true
RAG_SEARCH_PLANNER_MODEL=
RAG_SEARCH_PLANNER_MAX_TOKENS=800

# OpenAI-compatible (optional)
# ProxyAPI examples:
# - base_url can be with or without /v1 (both work):
#   LLM_BASE_URL=https://api.proxyapi.ru/openai/v1
#   LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_FALLBACK_MODEL=
LLM_MAX_TOKENS=2500

# Embeddings (OpenAI-compatible)
# Example:
#   EMBEDDINGS_PROVIDER=openai_compat
#   EMBEDDINGS_BASE_URL=https://api.proxyapi.ru/openai/v1/embeddings
#   EMBEDDINGS_MODEL=text-embedding-3-large
EMBEDDINGS_PROVIDER=
EMBEDDINGS_BASE_URL=
EMBEDDINGS_API_KEY=
EMBEDDINGS_MODEL=
EMBEDDINGS_BATCH_SIZE=64
